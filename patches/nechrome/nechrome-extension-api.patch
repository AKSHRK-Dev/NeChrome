diff --git a/chrome/common/extensions/api/nechrome.json b/chrome/common/extensions/api/nechrome.json
new file mode 100644
index 0000000000..737bf12643
--- /dev/null
+++ b/chrome/common/extensions/api/nechrome.json
@@ -0,0 +1,59 @@
+// Copyright 2026 ASHIKA Group. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+[
+  {
+    "namespace": "nechrome",
+    "description": "NeChrome only. Lets extensions change parts of the browser that Chrome does not open to extensions: how many rows the bookmark bar may use, and the default search engine.",
+    "types": [
+      {
+        "id": "SearchEngine",
+        "type": "object",
+        "description": "A search engine from the browser's list.",
+        "properties": {
+          "id": {"type": "string", "description": "Identifier to pass to setDefaultSearchEngine()."},
+          "name": {"type": "string", "description": "The name shown to the user."},
+          "keyword": {"type": "string", "description": "The keyword typed in the address bar to use this engine."},
+          "isDefault": {"type": "boolean", "description": "Whether this is the current default search engine."}
+        }
+      }
+    ],
+    "functions": [
+      {
+        "name": "getBookmarkBarMaxRows",
+        "type": "function",
+        "description": "Returns how many rows the bookmark bar may wrap onto (1 means a single row, like Chrome).",
+        "parameters": [],
+        "returns_async": {
+          "name": "callback",
+          "parameters": [{"name": "rows", "type": "integer"}]
+        }
+      },
+      {
+        "name": "setBookmarkBarMaxRows",
+        "type": "function",
+        "description": "Sets how many rows the bookmark bar may wrap onto, from 1 to 5. Bookmarks that still do not fit go to the overflow menu.",
+        "parameters": [{"name": "rows", "type": "integer", "minimum": 1, "maximum": 5}],
+        "returns_async": {"name": "callback", "parameters": []}
+      },
+      {
+        "name": "getSearchEngines",
+        "type": "function",
+        "description": "Returns the search engines that can be made the default (the main list on the settings page).",
+        "parameters": [],
+        "returns_async": {
+          "name": "callback",
+          "parameters": [{"name": "engines", "type": "array", "items": {"$ref": "SearchEngine"}}]
+        }
+      },
+      {
+        "name": "setDefaultSearchEngine",
+        "type": "function",
+        "description": "Makes the given search engine the default, as if the user chose it on the settings page.",
+        "parameters": [{"name": "id", "type": "string"}],
+        "returns_async": {"name": "callback", "parameters": []}
+      }
+    ]
+  }
+]
