+
+#ifndef CHROME_BROWSER_EXTENSIONS_API_NECHROME_NECHROME_API_H_
+#define CHROME_BROWSER_EXTENSIONS_API_NECHROME_NECHROME_API_H_
+
+#include "extensions/browser/extension_function.h"
+
+// NeChrome: chrome.nechrome. Lets extensions change the number of bookmark bar
+// rows and the default search engine, which Chrome keeps closed to extensions.
+
+class NechromeGetBookmarkBarMaxRowsFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("nechrome.getBookmarkBarMaxRows",
+                             NECHROME_GETBOOKMARKBARMAXROWS)
+
+ protected:
+  ~NechromeGetBookmarkBarMaxRowsFunction() override = default;
+  ResponseAction Run() override;
+};
+
+class NechromeSetBookmarkBarMaxRowsFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("nechrome.setBookmarkBarMaxRows",
+                             NECHROME_SETBOOKMARKBARMAXROWS)
+
+ protected:
+  ~NechromeSetBookmarkBarMaxRowsFunction() override = default;
+  ResponseAction Run() override;
+};
+
+class NechromeGetSearchEnginesFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("nechrome.getSearchEngines",
+                             NECHROME_GETSEARCHENGINES)
+
+ protected:
+  ~NechromeGetSearchEnginesFunction() override = default;
+  ResponseAction Run() override;
+};
+
+class NechromeSetDefaultSearchEngineFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("nechrome.setDefaultSearchEngine",
+                             NECHROME_SETDEFAULTSEARCHENGINE)
+
+ protected:
+  ~NechromeSetDefaultSearchEngineFunction() override = default;
+  ResponseAction Run() override;
+};
+
+#endif  // CHROME_BROWSER_EXTENSIONS_API_NECHROME_NECHROME_API_H_
