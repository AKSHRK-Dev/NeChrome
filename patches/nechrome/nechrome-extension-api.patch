diff --git a/chrome/browser/extensions/api/nechrome/nechrome_api.cc b/chrome/browser/extensions/api/nechrome/nechrome_api.cc
new file mode 100644
index 0000000000..9c0bee5488
--- /dev/null
+++ b/chrome/browser/extensions/api/nechrome/nechrome_api.cc
@@ -0,0 +1,107 @@
+// Copyright 2026 ASHIKA Group. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/nechrome/nechrome_api.h"
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "base/strings/number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "chrome/common/extensions/api/nechrome.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_service.h"
+
+namespace nechrome = extensions::api::nechrome;
+
+namespace {
+
+constexpr int kMaxRows = 5;
+
+// Incognito windows use the regular profile's settings.
+Profile* OriginalProfile(content::BrowserContext* context) {
+  return Profile::FromBrowserContext(context)->GetOriginalProfile();
+}
+
+TemplateURLService* LoadedService(content::BrowserContext* context) {
+  TemplateURLService* service =
+      TemplateURLServiceFactory::GetForProfile(OriginalProfile(context));
+  if (!service) {
+    return nullptr;
+  }
+  service->Load();
+  return service->loaded() ? service : nullptr;
+}
+
+constexpr char kNotReady[] =
+    "The search engine list is still loading. Please try again.";
+
+}  // namespace
+
+ExtensionFunction::ResponseAction NechromeGetBookmarkBarMaxRowsFunction::Run() {
+  const int rows = OriginalProfile(browser_context())
+                       ->GetPrefs()
+                       ->GetInteger(prefs::kNeChromeBookmarkBarMaxRows);
+  return RespondNow(ArgumentList(nechrome::GetBookmarkBarMaxRows::Results::Create(
+      std::clamp(rows, 1, kMaxRows))));
+}
+
+ExtensionFunction::ResponseAction NechromeSetBookmarkBarMaxRowsFunction::Run() {
+  auto params = nechrome::SetBookmarkBarMaxRows::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  if (params->rows < 1 || params->rows > kMaxRows) {
+    return RespondNow(Error("rows must be between 1 and 5."));
+  }
+  OriginalProfile(browser_context())
+      ->GetPrefs()
+      ->SetInteger(prefs::kNeChromeBookmarkBarMaxRows, params->rows);
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction NechromeGetSearchEnginesFunction::Run() {
+  TemplateURLService* service = LoadedService(browser_context());
+  if (!service) {
+    return RespondNow(Error(kNotReady));
+  }
+  const TemplateURL* current = service->GetDefaultSearchProvider();
+  std::vector<nechrome::SearchEngine> engines;
+  for (TemplateURL* url : service->GetTemplateURLs()) {
+    if (!service->ShowInDefaultList(url) || !service->CanMakeDefault(url)) {
+      continue;
+    }
+    nechrome::SearchEngine engine;
+    engine.id = base::NumberToString(url->id());
+    engine.name = base::UTF16ToUTF8(url->short_name());
+    engine.keyword = base::UTF16ToUTF8(url->keyword());
+    engine.is_default = url == current;
+    engines.push_back(std::move(engine));
+  }
+  return RespondNow(
+      ArgumentList(nechrome::GetSearchEngines::Results::Create(engines)));
+}
+
+ExtensionFunction::ResponseAction NechromeSetDefaultSearchEngineFunction::Run() {
+  auto params = nechrome::SetDefaultSearchEngine::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  TemplateURLService* service = LoadedService(browser_context());
+  if (!service) {
+    return RespondNow(Error(kNotReady));
+  }
+  for (TemplateURL* url : service->GetTemplateURLs()) {
+    if (base::NumberToString(url->id()) != params->id) {
+      continue;
+    }
+    if (!service->ShowInDefaultList(url) || !service->CanMakeDefault(url)) {
+      return RespondNow(Error("This search engine cannot be the default."));
+    }
+    service->SetUserSelectedDefaultSearchProvider(url);
+    return RespondNow(NoArguments());
+  }
+  return RespondNow(Error("No search engine has that id."));
+}
