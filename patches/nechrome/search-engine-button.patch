@@ -0,0 +1,62 @@
+// Copyright 2026 ASHIKA Group. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TOOLBAR_NECHROME_SEARCH_ENGINE_BUTTON_H_
+#define CHROME_BROWSER_UI_VIEWS_TOOLBAR_NECHROME_SEARCH_ENGINE_BUTTON_H_
+
+#include <memory>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_button.h"
+#include "components/search_engines/template_url_service.h"
+#include "components/search_engines/template_url_service_observer.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/menus/simple_menu_model.h"
+
+class Profile;
+class TemplateURL;
+
+namespace views {
+class MenuRunner;
+}
+
+// NeChrome: a button next to the location bar that shows the default search
+// engine and lets the user switch it from a menu, without opening settings.
+class NeChromeSearchEngineButton : public ToolbarButton,
+                                   public ui::SimpleMenuModel::Delegate,
+                                   public TemplateURLServiceObserver {
+  METADATA_HEADER(NeChromeSearchEngineButton, ToolbarButton)
+
+ public:
+  explicit NeChromeSearchEngineButton(Profile* profile);
+  NeChromeSearchEngineButton(const NeChromeSearchEngineButton&) = delete;
+  NeChromeSearchEngineButton& operator=(const NeChromeSearchEngineButton&) =
+      delete;
+  ~NeChromeSearchEngineButton() override;
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override;
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+  // TemplateURLServiceObserver:
+  void OnTemplateURLServiceChanged() override;
+  void OnTemplateURLServiceShuttingDown() override;
+
+ private:
+  void ShowEngineMenu();
+  void UpdateTooltip();
+
+  raw_ptr<TemplateURLService> service_;
+  // Engines in the order they appear in the menu (the command id is the
+  // index).
+  std::vector<raw_ptr<TemplateURL>> engines_;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+  base::ScopedObservation<TemplateURLService, TemplateURLServiceObserver>
+      observation_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_NECHROME_SEARCH_ENGINE_BUTTON_H_
