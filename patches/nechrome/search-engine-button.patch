diff --git a/chrome/browser/ui/views/toolbar/nechrome_search_engine_button.cc b/chrome/browser/ui/views/toolbar/nechrome_search_engine_button.cc
new file mode 100644
index 0000000000..1e102eb887
--- /dev/null
+++ b/chrome/browser/ui/views/toolbar/nechrome_search_engine_button.cc
@@ -0,0 +1,96 @@
+// Copyright 2026 ASHIKA Group. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/toolbar/nechrome_search_engine_button.h"
+
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "components/search_engines/template_url.h"
+#include "components/vector_icons/vector_icons.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/mojom/menu_source_type.mojom.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/button/menu_button_controller.h"
+#include "ui/views/controls/menu/menu_runner.h"
+
+NeChromeSearchEngineButton::NeChromeSearchEngineButton(Profile* profile)
+    : ToolbarButton(
+          base::BindRepeating(&NeChromeSearchEngineButton::ShowEngineMenu,
+                              base::Unretained(this))),
+      service_(TemplateURLServiceFactory::GetForProfile(profile)) {
+  SetVectorIcon(vector_icons::kSearchIcon);
+  GetViewAccessibility().SetName(u"Search engine");
+  if (service_) {
+    observation_.Observe(service_.get());
+    service_->Load();
+  }
+  UpdateTooltip();
+}
+
+NeChromeSearchEngineButton::~NeChromeSearchEngineButton() = default;
+
+void NeChromeSearchEngineButton::ShowEngineMenu() {
+  if (!service_ || !service_->loaded()) {
+    return;
+  }
+  engines_.clear();
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  for (TemplateURL* engine : service_->GetTemplateURLs()) {
+    // Only engines that can be the default (the ones on the settings page's
+    // main list) are offered.
+    if (!service_->ShowInDefaultList(engine) ||
+        !service_->CanMakeDefault(engine)) {
+      continue;
+    }
+    menu_model_->AddCheckItem(static_cast<int>(engines_.size()),
+                              engine->short_name());
+    engines_.push_back(engine);
+  }
+  if (engines_.empty()) {
+    return;
+  }
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::HAS_MNEMONICS);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, GetAnchorBoundsInScreen(),
+                          views::MenuAnchorPosition::kTopLeft,
+                          ui::mojom::MenuSourceType::kNone);
+}
+
+bool NeChromeSearchEngineButton::IsCommandIdChecked(int command_id) const {
+  if (!service_ || command_id < 0 ||
+      static_cast<size_t>(command_id) >= engines_.size()) {
+    return false;
+  }
+  return engines_[command_id] == service_->GetDefaultSearchProvider();
+}
+
+void NeChromeSearchEngineButton::ExecuteCommand(int command_id,
+                                                int event_flags) {
+  if (!service_ || command_id < 0 ||
+      static_cast<size_t>(command_id) >= engines_.size()) {
+    return;
+  }
+  service_->SetUserSelectedDefaultSearchProvider(engines_[command_id]);
+}
+
+void NeChromeSearchEngineButton::OnTemplateURLServiceChanged() {
+  UpdateTooltip();
+}
+
+void NeChromeSearchEngineButton::OnTemplateURLServiceShuttingDown() {
+  observation_.Reset();
+  engines_.clear();
+  service_ = nullptr;
+}
+
+void NeChromeSearchEngineButton::UpdateTooltip() {
+  const TemplateURL* engine =
+      service_ ? service_->GetDefaultSearchProvider() : nullptr;
+  SetTooltipText(engine ? u"Search engine: " + engine->short_name()
+                        : u"Search engine");
+}
+
+BEGIN_METADATA(NeChromeSearchEngineButton)
+END_METADATA
