+namespace {
+// NeChrome: upper bound for the number of rows an extension can ask for.
+constexpr int kNeChromeRowLimit = 5;
+// NeChrome: vertical gap between two rows of bookmark buttons.
+constexpr int kNeChromeRowGap = 4;
+int NeChromeRowStep() {
+  return GetLayoutConstant(LayoutConstant::kBookmarkBarButtonHeight) +
+         kNeChromeRowGap;
+}
+}  // namespace
+
+int BookmarkBarView::NeChromeMaxRows() const {
+  if (!nechrome_prefs_.prefs()) {
+    return 1;
+  }
+  return std::clamp(
+      nechrome_prefs_.prefs()->GetInteger(prefs::kNeChromeBookmarkBarMaxRows),
+      1, kNeChromeRowLimit);
+}
+
+void BookmarkBarView::NeChromeRowsChanged() {
+  PreferredSizeChanged();
+  // The browser window lays out the bookmark bar from its preferred height,
+  // so ask it to lay out again for the new number of rows.
+  if (browser_view_) {
+    browser_view_->InvalidateLayout();
+  }
+}
